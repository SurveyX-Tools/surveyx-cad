<Project Sdk="Microsoft.NET.Sdk">
  <!-- Randomised stress test of the calculation core: > 1,000,000 independent checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\SurveyXCAD\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <None Include="reference_vectors.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
